{
  "manifest_version": 3,
  "name": "Anyday — Real Cost",
  "version": "0.1.0",
  "description": "Before you click buy: what this actually costs you, in your own terms — not just kr.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["data.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
